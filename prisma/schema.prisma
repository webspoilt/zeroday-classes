generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model JobPost {
  id           String   @id @default(cuid())
  title        String
  organization String
  postDate     DateTime @default(now())
  lastDate     DateTime
  vacancies    Int?
  qualification String?
  category     String
  applyLink    String
  notificationPdf String?
  isNew        Boolean  @default(true)
  
  // Optional relations
  courseId     String?
}
