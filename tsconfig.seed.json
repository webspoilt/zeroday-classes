{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "module": "CommonJS",
        "moduleResolution": "node",
        "target": "ES2020",
        "outDir": "dist",
        "noEmit": false,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "isolatedModules": false
    },
    "include": [
        "src/scripts/seed.ts",
        "src/data/**/*",
        "src/lib/**/*"
    ],
    "exclude": [
        "node_modules"
    ]
}